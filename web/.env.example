# Copy to web/.env.local for local development once staging is provisioned.
# Vercel project Root Directory must be web/; set preview and production separately.
# Browser-safe publishable key; NEVER place a service-role token here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side only; use staging values in Preview. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only 32-byte base64 key; use separate values for each environment.
PROFILE_DESCRIPTION_KEY=
EMBEDDING_SERVICE_URL=http://localhost:8000
# Server-only secrets; never expose them to the browser.
EMBEDDING_SERVICE_TOKEN=
# Use true for a protected Vercel service with an authorized Trusted Sources rule.
EMBEDDING_SERVICE_USE_VERCEL_OIDC=false

# Disabled by default and always disabled on Vercel production.
ENABLE_MOCK_FEED=false

# Frontend data source: mock (default, fictional in-memory data) or http.
# Only select http once the authenticated feed + event endpoints exist.
NEXT_PUBLIC_FEED_API_MODE=mock
